<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Retries, and paid orders no queue consumer picked up. One indexed query when idle. -->
        <job name="bluebarry_send_due_conversions" instance="Bluebarry\Bluebarry\Cron\SendDueConversions" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <!-- Daily heartbeat per website (and right after an upgrade). Reads one flag when nothing is due. -->
        <job name="bluebarry_send_heartbeat" instance="Bluebarry\Bluebarry\Cron\SendHeartbeat" method="execute">
            <schedule>*/10 * * * *</schedule>
        </job>
    </group>
    <group id="bluebarry">
        <!-- Catalog sync: changed products in batches, at most 50 seconds a run. One query when idle. -->
        <job name="bluebarry_sync_catalog" instance="Bluebarry\Bluebarry\Cron\SyncCatalog" method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
