<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Every add to the cart, noted for the SDK to report (one cookie, no request to bluebarry). -->
    <event name="checkout_cart_product_add_after">
        <observer name="bluebarry_note_add_to_cart" instance="Bluebarry\Bluebarry\Observer\NoteAddToCart" />
    </event>
</config>
