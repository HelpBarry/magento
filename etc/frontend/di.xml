<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- A line edited in the cart is re-added by Magento: not an add for bluebarry. -->
    <type name="Magento\Quote\Model\Quote">
        <plugin name="bluebarry_ignore_line_edits" type="Bluebarry\Bluebarry\Plugin\Quote\IgnoreLineEdits" />
    </type>
    <!-- The cart section also says what is in the cart the way bluebarry names it (recommendation blocks). -->
    <type name="Magento\Checkout\CustomerData\Cart">
        <plugin name="bluebarry_cart_references" type="Bluebarry\Bluebarry\Plugin\Checkout\CartReferences" />
    </type>
    <!-- Asked on every totals collection of the storefront: the discount code is only built for a shopper
         who has a bluebarry code waiting. -->
    <type name="Bluebarry\Bluebarry\Observer\ApplyWaitingCode">
        <arguments>
            <argument name="cart" xsi:type="object">Bluebarry\Bluebarry\Model\Discount\Cart\Proxy</argument>
        </arguments>
    </type>
</config>
