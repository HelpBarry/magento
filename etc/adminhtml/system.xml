<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system.xsd">
    <system>
        <tab id="bluebarry" translate="label" sortOrder="10">
            <label>Bluebarry</label>
        </tab>
        <section id="bluebarry_module" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="1">
            <class>separator-top</class>
            <label>General</label>
            <tab>bluebarry</tab>
            <resource>Bluebarry_Bluebarry::config</resource>
            <group id="general" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="tenantid" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tenant ID</label>
                    <comment>You can find your Tenant ID on the integrations page in your bluebarry account.</comment>
                </field>
                <field id="write_to_debug_file" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Write conversion requests to debug log</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>