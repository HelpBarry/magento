#!/usr/bin/env bash
# Generates a throwaway CA and a TLS cert for data.bluebarry.ai, used by the mock API.
set -euo pipefail
CERT_DIR="$(cd "$(dirname "$0")/.." && pwd)/.certs"
mkdir -p "$CERT_DIR"
[ -f "$CERT_DIR/server.crt" ] && exit 0

docker run --rm -v "$CERT_DIR:/certs" -w /certs alpine:3.20 sh -ec '
apk add --no-cache openssl >/dev/null
openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=Bluebarry Test CA" -keyout ca.key -out ca.crt 2>/dev/null
openssl req -newkey rsa:2048 -nodes -subj "/CN=data.bluebarry.ai" -keyout server.key -out server.csr 2>/dev/null
printf "subjectAltName=DNS:data.bluebarry.ai\n" > ext.cnf
openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -days 3650 -extfile ext.cnf -out server.crt 2>/dev/null
rm server.csr ext.cnf
chmod 644 *
'
echo "Generated test certificates in $CERT_DIR"
