#!/usr/bin/env bash
# Reproduces a zero-downtime (symlink/release-directory) deploy that installs the module for the first
# time, the setup behind the 1.0.3 incident: while the new release runs setup:upgrade, the still-live
# old release keeps re-caching queue config into the shared cache.
#
# Usage: dev/bin/test-deploy-race [module.zip]      (default: the working tree)
#   e.g. dev/bin/test-deploy-race dist/bluebarry-magento2-module-1.0.2.zip   -> expected to FAIL (pre-fix)
#
# Leaves the module installed from the working tree afterwards, so the stack is usable again.
set -uo pipefail
BIN="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$BIN/../.." && pwd)"
compose() { "$BIN/compose" "$@"; }
in_php() { compose exec -T -u www-data php bash -ec "$1"; }
ZIP="${1:-}"
[ -n "$ZIP" ] && ZIP="$(cd "$(dirname "$ZIP")" && pwd)/$(basename "$ZIP")"

echo "==> Baseline: live shop without the module"
in_php '
    composer remove --no-interaction --no-progress bluebarry/magento2-module >/dev/null 2>&1 || true
    mysql -hdb -umagento -pmagento magento -e "DELETE FROM setup_module WHERE module = \"Bluebarry_Bluebarry\"; DELETE FROM queue WHERE name = \"bluebarry_conversion_process\";"
    php bin/magento setup:upgrade --no-interaction >/dev/null
    php bin/magento setup:di:compile >/dev/null 2>&1
    php bin/magento cache:flush >/dev/null
'
compose exec -T rabbitmq sh -c 'rabbitmqctl delete_queue bluebarry_conversion_process; rabbitmqctl eval "rabbit_exchange:delete(rabbit_misc:r(<<\"/\">>, exchange, <<\"bluebarry-conversion-exchange\">>), false, <<\"test\">>)."' >/dev/null 2>&1 || true

echo "==> Snapshot the live release (release-a) and keep it busy re-caching config"
compose exec -T php rm -f /tmp/stop-recache /tmp/recache.count
in_php 'rm -rf /var/www/release-a && rsync -a --exclude var/cache --exclude var/page_cache --exclude pub/media /var/www/html/ /var/www/release-a/'
compose exec -d -u www-data -w /var/www/release-a php \
    bash -c 'n=0; while [ ! -f /tmp/stop-recache ]; do php /module/dev/tools/recache-communication-config.php; n=$((n+1)); echo $n > /tmp/recache.count; done'

echo "==> Deploying the new release (installs the module) while release-a is live"
set +e
OUTPUT="$("$BIN/deploy-module" ${ZIP:+"$ZIP"} 2>&1)"
STATUS=$?
set -e

compose exec -T php touch /tmp/stop-recache
echo "    (release-a re-cached the config $(compose exec -T php cat /tmp/recache.count 2>/dev/null || echo 0) times during the deploy)"
sleep 3  # let the loop see the stop file before release-a disappears
in_php 'php bin/magento maintenance:disable >/dev/null; rm -rf /var/www/release-a'

if [ $STATUS -ne 0 ]; then
    echo "$OUTPUT" | tail -25
    echo
    echo "FAIL: deploy with a live old release failed"
    grep -q "is synchronous" <<<"$OUTPUT" && echo "      (the 1.0.3 failure: topic missing from the re-cached communication config)"
    [ -n "$ZIP" ] && { echo "==> Restoring the working-tree module"; "$BIN/deploy-module" >/dev/null 2>&1; }
    exit 1
fi
echo "$OUTPUT" | tail -3
echo "PASS: first-install deploy survived the live old release"

# The deploy finishing is not enough: the old release kept running past the final cache flush, as
# long-running consumers and cron do in production. Can the new release still publish conversions?
echo "==> After the deploy: is the conversion topic in the (shared) cached queue config?"
TOPIC_STATE="$(in_php 'php -r "
    require \"app/bootstrap.php\";
    \$om = Magento\\Framework\\App\\Bootstrap::create(BP, \$_SERVER)->getObjectManager();
    echo isset(\$om->get(Magento\\Framework\\Communication\\ConfigInterface::class)->getTopics()[\"bluebarry.conversion.process\"]) ? \"present\" : \"missing\";
"')"
in_php 'php bin/magento cache:flush >/dev/null'
[ -n "$ZIP" ] && { echo "==> Restoring the working-tree module"; "$BIN/deploy-module" >/dev/null 2>&1; }
if [ "$TOPIC_STATE" != "present" ]; then
    echo "FAIL: topic $TOPIC_STATE. Until the next cache flush every conversion is dropped at checkout"
    echo "      (system.log: Error publishing conversion to message queue: Topic ... is not configured)."
    exit 1
fi
echo "PASS: conversions can be published after the deploy"
