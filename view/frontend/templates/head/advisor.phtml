<?php
/**
 * @var $block \Bluebarry\Bluebarry\Block\Advisor
 */
$tenantId = $block->getTenantId(); 

if ($tenantId != null && $tenantId != "") {
?>
<script nonce="<?= $block->escapeHtmlAttr($block->getNonce()); ?>">
    window.barry = window.barry || {};
    window.barry.tenantId = "<?= $block->escapeJs($tenantId); ?>";
    window.barry.platform = "magento";
    // The SDK's Magento cart bridge adds through the module (bluebarry/cart/add).
    window.barry.magento = {
        addToCartUrl: "<?= $block->escapeJs($block->getUrl('bluebarry/cart/add')); ?>",
        cartUrl: "<?= $block->escapeJs($block->getUrl('checkout/cart')); ?>"
    };
    // The SDK sends page views, product views and adds to the cart itself on Magento, which has no web
    // pixel (SDK/src/storefront). The page describes itself: only what its address decides, so a page
    // from the full page cache is right for everyone.
    window.barry.trackPageViews = true;
    window.barry.pageContext = Object.assign(<?= /* @noEscape */ json_encode($block->getPageContext(), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT); ?>, window.barry.pageContext);
    window.barry.chat = Object.assign({}, window.barry.chat, <?= /* @noEscape */ json_encode($block->getChatConfig(), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT); ?>);
<?php $consentWebsite = $block->getCookieConsentWebsite(); ?>
<?php if ($consentWebsite !== null): ?>
    // Magento's cookie restriction mode: nothing is tracked until the shopper allowed cookies.
    window.barry.analyticsAllowed = window.barry.analyticsAllowed || function () {
        var match = document.cookie.match(/(?:^|; )user_allowed_save_cookie=([^;]*)/);
        try { return !!match && JSON.parse(decodeURIComponent(match[1]))[<?= (int) $consentWebsite ?>] == 1; } catch (e) { return false; }
    };
<?php endif; ?>
    // The cart changed (Luma's customer data, Hyvä's private content): the SDK reports the adds noted
    // since and updates popup cart rules.
    (function () {
        function cartChanged() { document.dispatchEvent(new CustomEvent('cart:updated')); }
        window.addEventListener('private-content-loaded', cartChanged);
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof window.require !== 'function') return;
            window.require(['Magento_Customer/js/customer-data'], function (customerData) {
                customerData.get('cart').subscribe(cartChanged);
            });
        });
    })();
<?php $search = $block->getSearchConfig(); ?>
<?php if ($search !== null): ?>
    // Search, as chosen in Studio.
    window.barry.search = Object.assign({}, window.barry.search, <?= /* @noEscape */ json_encode($search, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES); ?>);
<?php if (!empty($search['serpPage']['here'])): ?>
    // The results page is bluebarry's: hide Magento's results before they paint, and show them again
    // if the SDK has not taken the page over in time (crawlers and shoppers without the SDK keep them).
    (function () {
        var style = document.createElement('style');
        style.id = 'bb-serp-guard';
        style.textContent = <?= /* @noEscape */ json_encode($block->getResultsHost() . ' > *:not([data-bluebarry-serp]) { visibility: hidden !important; }', JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT); ?>;
        document.head.appendChild(style);
        var started = Date.now(), watch = setInterval(function () {
            if ((window.barry && window.barry._serpMounted) || Date.now() - started > 2500) { style.remove(); clearInterval(watch); }
        }, 50);
    })();
<?php endif; ?>
<?php endif; ?>
    var advisorScript = document.createElement('script');
    advisorScript.async = true;
    advisorScript.src = "https://cdn.bluebarry.ai/advisor/advisor.js";
    document.head.appendChild(advisorScript);

    function getFormKey() {
        var match = document.cookie.match(/form_key=([^;]+)/);
        return match ? match[1] : null;
    }

    function updateSession(advisorId, sessionId, userId) {
        var formKey = getFormKey();
        fetch('/bluebarry/session/update', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({
                form_key: formKey,
                bb_session_id: sessionId,
                advisor_id: advisorId,
                user_id: userId,
            })
        })
        .then(function(response) { return response.json(); })
        .then(function(response) {
            if (!response.success) {
                console.error("Unable to set bluebarry session");
            }
        })
        .catch(function(err) {
            console.error("Unable to set bluebarry session");
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        const sessionRaw = localStorage.getItem('barry-session');
        if (!sessionRaw)
            return;

        const session = JSON.parse(sessionRaw);
        const now = Date.now();

        const lastUpdateRaw = localStorage.getItem('barry-session-last-update');
        if (lastUpdateRaw && (now - parseInt(lastUpdateRaw, 10) < 60 * 60 * 1000))
            return;

        updateSession(session.advisorId, session.sessionId, session.userId);
        localStorage.setItem('barry-session-last-update', now.toString());
    });

    window.addEventListener('message', (message) => {
        if (message.origin !== "https://advisor.bluebarry.ai")
            return;
        const { event, value } = message.data;
        if (event !== "barry-analytics")
            return;

        const { name, data } = value;
        if (name !== "bluebarry_start_advisor")
            return;

        const obj = {
            advisorId: data.bluebarry_advisor_id,
            sessionId: data.bluebarry_session_id,
            userId: data.bluebarry_user_id,
            time: Date.now(),
        };

        let current = localStorage.getItem('barry-session');
        if (current)
            current = JSON.parse(current);

        if (current?.advisorId == obj.advisorId && current?.sessionId == obj.sessionId && current?.userId == obj.userId)
            return;

        localStorage.setItem('barry-session', JSON.stringify(obj));
        updateSession(obj.advisorId, obj.sessionId, obj.userId);
    });
</script>

<?php } ?>