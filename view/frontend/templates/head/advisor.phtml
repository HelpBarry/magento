    (function () {
        // With the cart section: Hyvä announces new sections before it stores them.
        function cartChanged(cart) { document.dispatchEvent(new CustomEvent('cart:updated', {detail: {cart: cart || null}})); }
        window.addEventListener('private-content-loaded', function (event) {
