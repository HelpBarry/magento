<?php
/**
 * The "Is this right for me?" button: on product pages when switched on in Studio, and wherever the
 * Product check widget is placed. Nothing for a product without a product check quiz.
 *
 * @var \Bluebarry\Bluebarry\Block\Placement $block
 * @var \Magento\Framework\Escaper $escaper
 */
if ($block->getData('placement') && $block->getPlacement((string) $block->getData('placement')) === null) {
    return;
}
$check = $block->getProductCheck((string) $block->getData('text'));
if ($check === null) {
    return;
}
?>
<div class="bluebarry-product-check" style="margin:12px 0">
    <a class="bluebarry-product-check__btn"
       href="<?= $escaper->escapeHtmlAttr($check['href']) ?>"
<?php if ($check['variants']): ?>
       data-bluebarry-variants="<?= $escaper->escapeHtmlAttr(implode(',', $check['variants'])) ?>"
<?php endif; ?>
       style="display:inline-block;padding:12px 24px;font-size:16px;font-weight:600;text-align:center;text-decoration:none;cursor:pointer;border:none;border-radius:4px;background-color:#121212;color:#ffffff;"><?= $escaper->escapeHtml($check['text']) ?></a>
</div>
<?php if ($check['variants']): ?>
<script nonce="<?= $escaper->escapeHtmlAttr($block->getNonce()) ?>">
    // The button follows the variant the shopper picks, as on Shopify and WooCommerce: once the options
    // name one variant bluebarry has for this product, the quiz opens for it; until then, and for any
    // other, for the one the page opens with. The page itself stays the same for every shopper.
    (function () {
        if (window.bluebarryFollowsVariant) return; // one script for every button on the page
        window.bluebarryFollowsVariant = true;
        function follow(id) {
            document.querySelectorAll('.bluebarry-product-check__btn[data-bluebarry-variants]').forEach(function (link) {
                if (!link.hasAttribute('data-bluebarry-href')) link.setAttribute('data-bluebarry-href', link.getAttribute('href'));
                var href = link.getAttribute('data-bluebarry-href');
                if (id && link.getAttribute('data-bluebarry-variants').split(',').indexOf(String(id)) !== -1) {
                    href = href.replace(/\/[^/]*$/, '/' + id);
                }
                link.setAttribute('href', href);
            });
        }
        // Hyvä: its options announce every change, with the variants still possible.
        window.addEventListener('configurable-selection-changed', function (event) {
            var candidates = event.detail && event.detail.candidates;
            follow(candidates && candidates.length === 1 ? candidates[0] : null);
        });
        // Luma: the product's swatches, or its option selects once each has a value (the last one changed
        // then names the variant). Read once the widgets have taken a change, and once they are set up:
        // an item's options page (cart, wishlist) opens with its saved options and no change. Delegated
        // from the body, beside the wishlist's own handler, which stops the change from going further.
        if (typeof window.require === 'function') {
            window.require(['jquery'], function ($) {
                $(document.body)
                    .on('change', '[name^="super_attribute"]', function () { setTimeout(picked); })
                    .on('configurable.initialized swatch.initialized', function () { setTimeout(picked); });
                picked();
                function picked() {
                    var form = $('#product_addtocart_form'), selects = form.data('mageConfigurable');
                    var swatches = form.find('[data-role=swatch-options]').data('mage-SwatchRenderer');
                    if (swatches) {
                        var products = swatches._CalcProducts();
                        follow(products.length === 1 ? products[0] : null);
                    } else if (selects) {
                        var open = form.find('select[name^="super_attribute"]').filter(function () { return !this.value; });
                        follow(open.length ? null : selects.simpleProduct);
                    }
                }
            });
        }
    })();
</script>
<?php endif; ?>
