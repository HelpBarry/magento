<?php
/**
 * On a product page, bluebarry's elements follow the variant the shopper picks, as on Shopify and
 * WooCommerce: the product check button opens the quiz for it, product chat answers for it and the
 * recommendation blocks lead with it. Until the options name one variant bluebarry has for the product,
 * and again when the choice is cleared, they keep the one the page opens with. Only the shopper's
 * browser changes: the page stays the same for every shopper, and nothing is requested.
 *
 * @var \Bluebarry\Bluebarry\Block\Placement $block
 * @var \Magento\Framework\Escaper $escaper
 */
$variants = $block->getPickableVariants();
if (!$variants) {
    return;
}
?>
<script nonce="<?= $escaper->escapeHtmlAttr($block->getNonce()) ?>">
    (function (variants) {
        if (window.bluebarryFollowsVariant) return;
        window.bluebarryFollowsVariant = true;
        var followed = null, pageVariant;
        function follow(id) {
            id = id && variants.indexOf(String(id)) !== -1 ? String(id) : null;
            if (id === followed) return;
            followed = id;
            // The page's own values are kept, so a cleared choice puts them back.
            document.querySelectorAll('.bluebarry-product-check__btn').forEach(function (link) {
                if (!link.hasAttribute('data-bluebarry-href')) link.setAttribute('data-bluebarry-href', link.getAttribute('href'));
                var href = link.getAttribute('data-bluebarry-href');
                link.setAttribute('href', id ? href.replace(/\/[^/]*$/, '/' + id) : href);
            });
            var changed = false;
            document.querySelectorAll('[data-bluebarry-recommendations][data-anchor-id]').forEach(function (block) {
                if (!block.hasAttribute('data-bluebarry-anchor')) block.setAttribute('data-bluebarry-anchor', block.getAttribute('data-anchor-id'));
                var anchor = id || block.getAttribute('data-bluebarry-anchor');
                if (block.getAttribute('data-anchor-id') !== anchor) {
                    block.setAttribute('data-anchor-id', anchor);
                    changed = true;
                }
            });
            var chat = window.barry && window.barry.chat;
            if (chat && typeof chat === 'object') {
                if (pageVariant === undefined) pageVariant = chat.variantReference;
                var variant = id || pageVariant;
                if (chat.variantReference !== variant) {
                    if (variant === undefined) delete chat.variantReference; else chat.variantReference = variant;
                    changed = true;
                }
            }
            // Product chat and the recommendation blocks take a variant change from this event.
            if (changed) document.dispatchEvent(new Event('change'));
        }
        // Hyvä: its options announce every change, with the variants still possible.
        window.addEventListener('configurable-selection-changed', function (event) {
            var candidates = event.detail && event.detail.candidates;
            follow(candidates && candidates.length === 1 ? candidates[0] : null);
        });
        // Luma: the product's swatches, or its option selects once each has a value (the last one changed
        // then names the variant). Read once the widgets have taken a change, and once they are set up:
        // an item's options page (cart, wishlist) opens with its saved options and no change. Delegated
        // from the body, beside the wishlist's own handler, which stops the change from going further.
        if (typeof window.require === 'function') {
            window.require(['jquery'], function ($) {
                $(document.body)
                    .on('change', '[name^="super_attribute"]', function () { setTimeout(picked); })
                    .on('configurable.initialized swatch.initialized', function () { setTimeout(picked); });
                picked();
                function picked() {
                    var form = $('#product_addtocart_form'), selects = form.data('mageConfigurable');
                    var swatches = form.find('[data-role=swatch-options]').data('mage-SwatchRenderer');
                    if (swatches) {
                        var products = swatches._CalcProducts();
                        follow(products.length === 1 ? products[0] : null);
                    } else if (selects) {
                        var open = form.find('select[name^="super_attribute"]').filter(function () { return !this.value; });
                        follow(open.length ? null : selects.simpleProduct);
                    }
                }
            });
        }
    })(<?= /* @noEscape */ json_encode(array_values($variants), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>);
</script>
